.env
/.venv/
.env.*
!.env.example
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
.corpus_freeze/
*.local.json
.DS_Store
# Isolated Hermes: PACBench-owned clone + venv + run homes/artifacts.
/vendor/hermes-isolated/
/vendor/venv-hermes-isolated/
/hermes-homes/
/artifacts/
# Track run evidence, but keep credentials, native stores and raw reasoning private.
/runs/**/hermes-home/
/runs/**/fallback-home/
/runs/**/memcal-home/
/runs/**/mem0-state/
/runs/**/qdrant/
/runs/**/openviking-data/
/runs/**/honcho-db/
/runs/**/supermemory-data/
/runs/**/tokenizer-cache/
/runs/**/model-cache/
/runs/**/model-calls/private/
/runs/**/ov.conf
/runs/**/*.db*
/runs/**/*.abcddb*
# Cumulative native fixture maps are rebuildable and only used with private DBs.
/runs/**/chat.fixture.json
/runs/**/*.log
/runs/**/*.private.*
/runs/**/honcho-reasoning-traces.jsonl
# Generated artifact.
docs/corpus-explorer.html

# Locally installed provider runtime dependencies.
/vendor/byterover-local/
/vendor/venv-openviking/
/vendor/venv-hindsight/
/vendor/supermemory-local/
/vendor/honcho-local/
/vendor/ollama/

# Preserve local OpenRouter spending reservations outside published evidence.
*.openrouter-private/

# Native backends are installed separately; never commit runtime symlinks.
/vendor/venv-cognee
/vendor/venv-reme
/vendor/cognee-integrations
/vendor/reme
/vendor/memos

# Runtime dependencies may be symlinks in an isolated integration checkout.
/vendor/byterover-local
/vendor/venv-openviking
/vendor/venv-hindsight
/vendor/supermemory-local
/vendor/honcho-local
/vendor/ollama
/vendor/libfaketime/runtime
