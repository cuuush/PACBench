{
  "version": "retained-memory-only-v2",
  "provider": "memcal",
  "allowed_tools": [
    "memcal_add",
    "memcal_alias",
    "memcal_answer",
    "memcal_drop",
    "memcal_list_days",
    "memcal_list_month",
    "memcal_merge",
    "memcal_move_once",
    "memcal_note",
    "memcal_open",
    "memcal_open_page",
    "memcal_refresh",
    "memcal_reviewed",
    "memcal_schedule",
    "memcal_search_wiki",
    "memcal_todo",
    "memcal_update"
  ],
  "blocked_source_tools": [
    "memcal_activity",
    "memcal_conversation",
    "memcal_open_source",
    "memcal_search_archive"
  ],
  "source_argument_rules": {
    "viking_read": {
      "scheme": "viking",
      "memory_namespaces": [
        "user",
        "agent",
        "~"
      ],
      "memory_path": "/memories/",
      "summary_suffixes": {
        "abstract": "/.abstract.md",
        "overview": "/.overview.md"
      },
      "default_level": "overview"
    }
  },
  "builtin_memory": false,
  "os_sandbox": false
}
