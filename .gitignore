/vendor/memos-models
/vendor/ollama
/vendor/reme
/vendor/supermemory-local
/vendor/supermemory-plugin
/vendor/venv-cognee
/vendor/venv-hermes-isolated
/vendor/venv-hindsight
/vendor/venv-openviking
/vendor/venv-reme
/.bootstrap-cache/

# Preserve local OpenRouter spending reservations outside published evidence.
*.openrouter-private/

# Native document-provider stores and background-worker payloads stay private.
