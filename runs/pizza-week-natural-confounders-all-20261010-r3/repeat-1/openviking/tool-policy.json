{
  "version": "retained-memory-only-v2",
  "provider": "openviking",
  "allowed_tools": [
    "viking_add_resource",
    "viking_browse",
    "viking_forget",
    "viking_read",
    "viking_remember",
    "viking_search"
  ],
  "blocked_source_tools": [],
  "source_argument_rules": {
    "viking_read": {
      "scheme": "viking",
      "memory_namespaces": [
        "user",
        "agent",
        "~"
      ],
      "memory_path": "/memories/",
      "summary_suffixes": {
        "abstract": "/.abstract.md",
        "overview": "/.overview.md"
      },
      "default_level": "overview"
    }
  },
  "builtin_memory": false,
  "os_sandbox": false
}
