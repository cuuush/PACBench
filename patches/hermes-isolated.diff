+def _pacbench_refresh_date(agent, prompt):
+    """Refresh native date before and after compaction for simulated turns."""
+    if not os.environ.get("PACBENCH_NOW", "").strip() or not prompt:
+        return prompt
+    import re
+    from agent.system_prompt import _timestamp_line
+    native_lines = _timestamp_line(agent).splitlines()
+    native_date = "\n".join(line for line in native_lines if
+        line.startswith("Conversation started: ") or
+        line.startswith("Today's date (as of the last context rebuild): "))
+    pattern = r"(?m)^Conversation started: [^\n]*(?:\nToday's date \(as of the last context rebuild\): [^\n]*)?"
+    refreshed, count = re.subn(pattern, lambda _: native_date, prompt)
+    if count != 1 or not native_date:
+        raise RuntimeError("PACBench cannot refresh native session date")
+    if refreshed != prompt:
+        agent._cached_system_prompt = refreshed
+        static = getattr(agent, "_cached_system_prompt_static", None)
+        if static and not refreshed.startswith(static):
+            agent._cached_system_prompt_static = None
+        if not agent._session_db:
+            raise RuntimeError("PACBench cannot persist native session date")
+        agent._session_db.update_system_prompt(agent.session_id, refreshed)
+    return refreshed
