# PACBench driver config — copy to .env (never commit; .env is gitignored).
# Scored runs read the driver model + credential ONLY from the PACBench-owned
# .env via pacbench.creds; live-profile auth is never used (contract isolation).

# Driver model served natively on Meta's Model API (https://api.meta.ai/v1).
MODEL=muse-spark-1.3-contributor

# Bearer credential for Meta's Model API. Installed at runtime as META_API_KEY;
# never printed, logged, or persisted into artifacts.
META=<credential>

# Spark generation (pacbench.generation / pacbench.render) uses this same
# gateway and credential — there is no second (OpenRouter) route.
