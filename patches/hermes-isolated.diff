 def now() -> datetime:
     """Current time as a tz-aware datetime: configured zone, else server-local."""
+    override = os.environ.get("PACBENCH_NOW", "").strip()
+    if override:
+        # PACBench isolated-run shim (benchmark harness only): pin the fictional
+        # clock. Same value for every provider; never set outside a run.
